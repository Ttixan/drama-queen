; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DramaQueen"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
run/main_scene="res://scenes/main_scene.tscn"

[autoload]

; 顺序要紧：EventBus 必须排在 Game 之前，Game 的 _ready() 依赖它
EventBus="*res://scripts/core/event_bus.gd"
Game="*res://scripts/core/game.gd"

[gui]

; 全局 UI 主题。手机壳是主场景之后，这一条才敢开 ——
; 在此之前只有独立场景在跑，不该顺手改全局配置。
; 【它是兜底，不是唯一来源】各 App 的 .tscn 仍然显式挂着同一个主题，
; 这里只是保证「新加的界面忘了挂 theme」时中文也不会掉进系统字体回退。
theme/custom="res://assets/ui/ui_theme.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "orange",
"res://scenes/": "green"
}

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
