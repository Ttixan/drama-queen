[sub_resource type="Resource" id="Resource_3bt7y"]
script = ExtResource("2_aq84a")
who = "me"
text = "徐女士您好，请问贵工作室还招收演员吗？我有一定的表演经验，随时可以进组。"

[sub_resource type="Resource" id="Resource_i578h"]
script = ExtResource("2_aq84a")
text = "你好。我们工作室主要做有文学表达的中短篇影像，不是那种流水线短剧。你对“表演”是怎么理解的？"

[sub_resource type="Resource" id="Resource_nani4"]
script = ExtResource("2_aq84a")
who = "me"
text = "我觉得表演就是真实地呈现角色的情绪，让观众共情。"

[sub_resource type="Resource" id="Resource_y3p7j"]
script = ExtResource("2_aq84a")
text = "共情……这个说法有些泛滥了。比起共情，我更看重演员能否呈现出人物在时代背景下的“失语”状态。先发一份你的素颜照和一段无滤镜的自我介绍视频吧。"

[sub_resource type="Resource" id="Resource_31u35"]
script = ExtResource("2_aq84a")
who = "me"
text = "（发送简历和一段视频）"

[sub_resource type="Resource" id="Resource_qy2nu"]
script = ExtResource("2_aq84a")
text = "外形有一点未经雕琢的粗粝感，眼神里有某种未经世事的空洞，还不错。之前演过什么？"

[sub_resource type="Resource" id="Resource_e0wum"]
script = ExtResource("2_aq84a")
who = "me"
text = "大学时演过一些话剧，我很能吃苦，情绪爆发戏没问题。"

[sub_resource type="Resource" id="Resource_on0mf"]
script = ExtResource("2_aq84a")
who = "choice"
text = "问薪水"

[sub_resource type="Resource" id="Resource_wgoln"]
script = ExtResource("2_aq84a")
who = "choice"
text = "问签约制度"

[sub_resource type="Resource" id="Resource_ypv2t"]
script = ExtResource("2_aq84a")
who = "choice"
text = "问怎么试镜"

[sub_resource type="Resource" id="Resource_t1ido"]
script = ExtResource("2_aq84a")
who = "me"
text = "请问咱们这边的薪资待遇是怎么算的？"
branch = 1

[sub_resource type="Resource" id="Resource_rtqhb"]
script = ExtResource("2_aq84a")
text = "我们是独立工作室，资金主要投入到制作本身。薪水可能没有那些拍竖屏短剧的丰厚，但我能提供给你的是纯粹的艺术氛围。希望你不是那种为了短期利益就随便妥协的人，有些东西比物质重要得多。"
branch = 1

[sub_resource type="Resource" id="Resource_f533x"]
script = ExtResource("2_aq84a")
who = "me"
text = "请问去了是签劳动合同还是单次项目合作？"
branch = 2

[sub_resource type="Resource" id="Resource_2yw2o"]
script = ExtResource("2_aq84a")
text = "我们不用冷冰冰的雇佣制度来束缚创作者。目前是按单次的项目合作来。在片场，我们需要的是同频的交流，而不是工业流水线上的螺丝钉。能接受这种自由但不确定的合作方式吗？"
branch = 2

[sub_resource type="Resource" id="Resource_olt3j"]
script = ExtResource("2_aq84a")
who = "me"
text = "请问试镜是什么流程？需要准备才艺吗？"
branch = 3

[sub_resource type="Resource" id="Resource_k3usy"]
script = ExtResource("2_aq84a")
text = "不用准备那些浮夸的才艺。我们需要的是能准确理解导演意图、能用微表情和肢体去传递暗流涌动的人。加我微信吧，我会发一段剧本给你。"
branch = 3

[sub_resource type="Resource" id="Resource_36goh"]
script = ExtResource("3_2n8ow")

[sub_resource type="Resource" id="Resource_20se3"]
script = ExtResource("3_2n8ow")
tier = 1
acting_required = 5
match_line = 0.5
acting_gain = 2
payout_ratio = 2.0

[sub_resource type="Resource" id="Resource_fhffx"]
script = ExtResource("3_2n8ow")
tier = 2
acting_required = 15
match_line = 0.7
acting_gain = 5
payout_ratio = 3.0

[sub_resource type="Resource" id="Resource_0vkpd"]
script = ExtResource("2_aq84a")
text = "（发送文件：《通用剧本_选段.pdf》）"

[sub_resource type="Resource" id="Resource_8cl42"]
script = ExtResource("2_aq84a")
text = "因为版权问题无法给到你公司内部的剧本选段。这是通用剧本试戏片段。你可以阅读后录制视频回传，试镜通过后我们可以再详谈。"

[sub_resource type="Resource" id="Resource_yym6n"]
script = ExtResource("2_aq84a")
who = "me"
text = "好的，我试着体会一下剧本中的情绪。"

[sub_resource type="Resource" id="Resource_q1y6t"]
script = ExtResource("2_aq84a")
text = "（发送文件：《本周必读：电影现象学与空间叙事.docx》）"

[sub_resource type="Resource" id="Resource_6r6if"]
script = ExtResource("2_aq84a")
text = "对了，这是我们工作室内部的阅片和阅读参考。你在录试镜视频前，最好先看看。我不希望看到一个连塔可夫斯基都没听说过的人，来演我们这种有文学厚度的剧本。录好了发我。"

[sub_resource type="Resource" id="Resource_pil01"]
script = ExtResource("2_aq84a")
who = "me"
text = "好的，我先去补补课。"

