roles = Array[ExtResource("3_ux0ye")]([SubResource("Resource_cg4l8"), SubResource("Resource_8milp"), SubResource("Resource_a4b8j")])
extra_payout = 120
good_play_chance = 0.8
tagline = "上市大厂与夸张的压榨制度"
industry = "广播／影视"
funding = "已上市"
scale = "10000 人以上"
position_title = "资深 AIGC 短剧制作师（集团直招／高薪急聘）"
salary = "25—40K·16 薪"
experience = "3—5 年｜本科"
tags = Array[String](["全流程制作", "绩效奖金", "股票期权", "弹性工作"])
posting_text = "千亿级内容生态，千万级项目资源。加入核心业务团队，与优秀的人一起，突破个人产能边界。
【岗位职责】
1. 独立完成短剧项目的剧本拆解、分镜设计、AI 素材生成、剪辑、配音、包装及上线交付。
2. 同步跟进多个项目，对产量、质量、交付周期及上线数据负责。
3. 持续优化工作流程。工具提效后，产量目标同步上调。
4. 及时响应业务需求，做到事事有回音、件件有着落、凌晨有回复。
【任职要求】
本科及以上学历，有成熟上线作品及爆款项目经验。
具备主人翁意识，抗压能力强，情绪稳定，不因需求变更影响交付。
善于主动发现工作，不依赖领导安排。不以\"已经下班\"作为问题的解决方案。
【工作安排】
实行弹性工作制，每日工作 18—23 小时，可根据项目进度灵活调整。
双月单休，每两个月可自主选择一天申请休息。
当期未休视为自愿放弃，不累计、不折现。
团队结果导向，不鼓励无效加班。因当日任务未完成而延长的工作时间，计入个人效率提升时间。
【薪酬福利】
全额五险一金，试用期全薪，工资每月准时到账。
项目奖金、年度调薪、股票期权，优秀者上不封顶。
免费三餐、下午茶、夜宵及凌晨加餐，让奋斗没有后顾之忧。
提供员工宿舍、淋浴间、洗衣房，减少不必要的通勤与回家。
每年两次健康体检，体检时间可计入当日休息时长。
生日当天可提前一小时下班，经直属负责人审批后执行。
集团已有超过一万名同事选择与我们共同成长。
期待同样不甘平凡的你。"
hint = "百象影业要「反转」。中间那下得掉头 —— 未完成电影工作室那种慢慢滑下来的，他们看不上。"
hr_name = "赵女士"
hr_title = "高级人才招聘专家"
hr_status = "刚刚活跃｜今日回复 100+ 次"
opening_chat = Array[ExtResource("2_j0x8g")]([SubResource("Resource_l0sje"), SubResource("Resource_122y7"), SubResource("Resource_rcxd1"), SubResource("Resource_ma7f5"), SubResource("Resource_e4j7v"), SubResource("Resource_o6qdy"), SubResource("Resource_7iqpk"), SubResource("Resource_1jdqm"), SubResource("Resource_0kbq5"), SubResource("Resource_i6ya1"), SubResource("Resource_0utmi"), SubResource("Resource_w3cgb"), SubResource("Resource_7jsb1"), SubResource("Resource_rf28h")])
